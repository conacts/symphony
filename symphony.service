[Unit]
Description=Symphony runtime and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/junction/symphony
EnvironmentFile=-%h/.config/symphony/symphony.env
Environment=SYMPHONY_SOURCE_REPO=%h/junction/symphony
Environment=SYMPHONY_SOURCE_REPOS=
Environment=SYMPHONY_DB_FILE=%h/junction/symphony/.symphony/runtime/symphony.db
Environment=SYMPHONY_RUNTIME_BASE_URL=http://127.0.0.1:4400
Environment=NEXT_PUBLIC_SYMPHONY_RUNTIME_BASE_URL=http://127.0.0.1:4400
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
