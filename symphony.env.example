LINEAR_API_KEY=your-linear-api-key
GITHUB_TOKEN=your-github-token
OPENROUTER_API_KEY=your-openrouter-api-key

LOG_LEVEL=info
SYMPHONY_DOCKER_WORKSPACE_IMAGE=symphony/workspace-runner:local
SYMPHONY_DASHBOARD_PORT=3000

SYMPHONY_SOURCE_REPO=/Users/connorsheehan/junction/symphony
SYMPHONY_GITHUB_REPOSITORY=conacts/symphony
SYMPHONY_LINEAR_TEAM_KEY=SYM

# For local dogfooding, keep SYMPHONY_SOURCE_REPOS unset so only Symphony is admitted.
# For multi-repo routing in one Linear workspace, give each repo its own teamKey in
# `.symphony/runtime.ts` and keep using the shared LINEAR_API_KEY.
# Current intended mapping:
# - conacts/symphony -> SYM
# - conacts/coldets-v2 -> COL
# SYMPHONY_SOURCE_REPOS=/Users/connorsheehan/junction/symphony,/absolute/path/to/another-repo
