LINEAR_API_KEY=your-linear-api-key
GITHUB_TOKEN=your-github-token

# Required only if GitHub webhook verification is enabled in the runtime policy.
# SYMPHONY_GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Required only if the runtime cannot infer the repo slug from GitHub metadata.
# SYMPHONY_GITHUB_REPOSITORY=conacts/coldets-v2

# Required only if you want to pin Linear mapping by team key instead of project slug.
# SYMPHONY_LINEAR_TEAM_KEY=COL

# Optional. If omitted, Symphony uses the repo-local default workspace root.
# SYMPHONY_WORKSPACE_ROOT=/home/cs/code/workspaces/coldets-v2

# Optional. If omitted, the service unit provides the admitted repo path.
# SYMPHONY_SOURCE_REPO=/home/cs/junction/coldets-v2

# Optional:
# OPENROUTER_API_KEY=your-openrouter-api-key
# LOG_LEVEL=debug
# SYMPHONY_DOCKER_WORKSPACE_IMAGE=symphony/workspace-runner:local
# SYMPHONY_DASHBOARD_PORT=3000
