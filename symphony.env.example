LINEAR_API_KEY=your-linear-api-key
LINEAR_API_KEY_SYM=your-symphony-linear-api-key
LINEAR_API_KEY_COLD=your-coldets-linear-api-key
GITHUB_TOKEN=your-github-token

# Single-repo shortcut. Use this when one Symphony process admits exactly one repo.
# SYMPHONY_SOURCE_REPO=/home/cs/junction/symphony

# Multi-repo source of truth. Comma-separated absolute repo paths.
# SYMPHONY_SOURCE_REPOS=/home/cs/junction/symphony,/home/cs/junction/coldets-v2

# Single-repo webhook secret shortcut.
# SYMPHONY_GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Multi-repo webhook secret map keyed by repository slug.
# SYMPHONY_GITHUB_WEBHOOK_SECRETS=conacts/symphony=secret-one,conacts/coldets-v2=secret-two

# Required only if the runtime cannot infer the repo slug from GitHub metadata.
# SYMPHONY_GITHUB_REPOSITORY=conacts/symphony

# Required only if you want to pin Linear mapping by team key instead of project slug.
# SYMPHONY_LINEAR_TEAM_KEY=COL

# Optional. If omitted, Symphony uses the repo-local default workspace root.
# SYMPHONY_WORKSPACE_ROOT=/home/cs/code/workspaces/symphony

# Optional:
# OPENROUTER_API_KEY=your-openrouter-api-key
# LOG_LEVEL=debug
# SYMPHONY_DOCKER_WORKSPACE_IMAGE=symphony/workspace-runner:local
# SYMPHONY_DASHBOARD_PORT=3000
